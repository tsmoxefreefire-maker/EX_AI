 "node_content": [
  {
   "node_id": "letters",
   "content_type": "text",
   "content_text": "رموز الكتابة؛ عددها ثمانية وعشرون حرفاً"
  },
  {
   "node_id": "harakat",
   "content_type": "text",
   "content_text": "الفتحة والضمة والكسرة والسكون؛ تضبط نطق الحرف"
  },
  {
   "node_id": "word",
   "content_type": "text",
   "content_text": "مجموعة حروف لها معنى"
  },
  {
   "node_id": "noun",
   "content_type": "text",
   "content_text": "كلمة تدل على إنسان أو حيوان أو شيء"
  },
  {
   "node_id": "verb",
   "content_type": "text",
   "content_text": "كلمة تدل على حدث في زمن"
  },
  {
   "node_id": "particle",
   "content_type": "text",
   "content_text": "كلمة لا يظهر معناها إلا مع غيرها مثل: في، على"
  },
  {
   "node_id": "sentence",
   "content_type": "text",
   "content_text": "كلمات مترابطة تعطي معنى تاماً"
  },
  {
   "node_id": "nominal",
   "content_type": "text",
   "content_text": "جملة تبدأ باسم"
  },
  {
   "node_id": "mubtada",
   "content_type": "text",
   "content_text": "اسم تبدأ به الجملة الاسمية"
  },
  {
   "node_id": "khabar",
   "content_type": "text",
   "content_text": "ما يُخبَر به عن المبتدأ ليتم المعنى"
  },
  {
   "node_id": "verbal",
   "content_type": "text",
   "content_text": "جملة تبدأ بفعل"
  },
  {
   "node_id": "faail",
   "content_type": "text",
   "content_text": "اسم يدل على من قام بالفعل"
  }
 ]
}