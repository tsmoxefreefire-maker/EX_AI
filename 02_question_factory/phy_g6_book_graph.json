 "node_content": [
  {
   "node_id": "force",
   "content_type": "text",
   "content_text": "دفع أو سحب يغيّر حركة الجسم؛ تُقاس بالنيوتن"
  },
  {
   "node_id": "motion",
   "content_type": "text",
   "content_text": "تغيّر مكان الجسم مع الزمن"
  },
  {
   "node_id": "speed",
   "content_type": "text",
   "content_text": "المسافة التي يقطعها الجسم في وحدة الزمن"
  },
  {
   "node_id": "gravity",
   "content_type": "text",
   "content_text": "قوة تسحب الأجسام نحو الأرض؛ تجعل الأشياء تسقط"
  },
  {
   "node_id": "friction",
   "content_type": "text",
   "content_text": "قوة تعيق حركة الأجسام المتلامسة؛ تبطئ الحركة"
  },
  {
   "node_id": "energy",
   "content_type": "text",
   "content_text": "القدرة على بذل شغل؛ لها أشكال كثيرة"
  },
  {
   "node_id": "electricity",
   "content_type": "text",
   "content_text": "طاقة تنتقل عبر الأسلاك؛ تشغّل الأجهزة"
  },
  {
   "node_id": "circuit",
   "content_type": "text",
   "content_text": "مسار مغلق يمر فيه التيار من البطارية إلى المصباح"
  },
  {
   "node_id": "magnet",
   "content_type": "text",
   "content_text": "جسم يجذب الحديد؛ له قطبان شمالي وجنوبي"
  },
  {
   "node_id": "light",
   "content_type": "text",
   "content_text": "طاقة تنتقل بخطوط مستقيمة؛ تمكّننا من الرؤية"
  },
  {
   "node_id": "sound",
   "content_type": "text",
   "content_text": "طاقة تنتقل بالاهتزاز؛ نسمعها بالأذن"
  }
 ]
}