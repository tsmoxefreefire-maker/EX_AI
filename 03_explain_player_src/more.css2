<style>
.needs rect{fill:var(--panel);stroke:var(--line);stroke-width:1.5}.needs text{font-size:11px;font-weight:800;fill:var(--muted)}
.chat{max-width:560px;margin:8px auto;display:flex;flex-direction:column;gap:6px;max-height:220px;overflow:auto}
.msg{padding:8px 12px;border-radius:14px;font-weight:700;max-width:80%;animation:pop .3s}.msg.me{align-self:flex-start;background:var(--chip)}.msg.them{align-self:flex-end;background:color-mix(in srgb,var(--good) 18%,var(--panel))}
.qbtns{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:8px 0}.qbtn{border:2px solid var(--brand);background:var(--panel);color:inherit;border-radius:999px;padding:6px 14px;font-weight:800;cursor:pointer;font-family:inherit}.qbtn.asked{opacity:.55;border-style:dashed}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;max-width:680px;margin:6px auto}
.fcard2{border:0;background:none;padding:0;perspective:800px;cursor:pointer;font-family:inherit;color:inherit;outline-offset:3px}
.fin{display:grid;width:100%;min-height:120px;transition:transform .5s;transform-style:preserve-3d}
.fcard2.flipped .fin{transform:rotateY(180deg)}
.ff,.fb{grid-area:1/1;display:grid;place-items:center;align-content:center;gap:4px;border-radius:14px;backface-visibility:hidden;-webkit-backface-visibility:hidden;padding:12px;font-weight:800;border:2px solid var(--line);min-height:120px;text-align:center;overflow-wrap:anywhere}
.ff{background:color-mix(in srgb,var(--brand) 12%,var(--panel))}.ff small{font-size:.75rem;color:var(--muted)}
.fb{background:var(--panel);transform:rotateY(180deg);font-size:.95rem;line-height:1.6}
.slider2{display:flex;gap:10px;align-items:center;justify-content:center;font-weight:800;max-width:620px;margin:6px auto}.slider2 input{flex:1}
/* 🎴 cards v2: no 3D, the card grows with its text */
.cards2{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;max-width:700px;margin:8px auto}
.card2b{border:2px solid var(--line);border-radius:16px;background:color-mix(in srgb,var(--brand) 10%,var(--panel));padding:14px 12px;min-height:110px;cursor:pointer;font-family:inherit;color:inherit;
  display:grid;place-items:center;text-align:center;transition:transform .16s ease-in,background .2s;font-weight:800;line-height:1.7;font-size:1rem;overflow-wrap:anywhere}
.card2b.flipped{background:var(--panel);border-color:var(--brand)}.card2b.turning{transform:scaleX(.04)}
.card2b .front small{display:block;font-size:.75rem;color:var(--muted);margin-top:6px}.card2b .back{font-weight:700}
@media (prefers-reduced-motion:reduce){.card2b{transition:none}}
/* 🎤 chat v2: a clear box, answers wrap */
.chatbox{max-width:640px;margin:8px auto;border:1px solid var(--line);border-radius:14px;background:var(--bg);padding:8px}
.chatbox .chat{max-width:none;margin:0;max-height:260px}.msg{overflow-wrap:anywhere;line-height:1.8;max-width:88%}.msg .kw{white-space:normal}
</style>
<style>.fbt{margin:0;line-height:1.7;font-size:.95rem;font-weight:700;display:block;max-width:100%}.fb .kw{display:inline}/* 🎴 cards v2: no 3D, the card grows with its text */
.cards2{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;max-width:700px;margin:8px auto}
.card2b{border:2px solid var(--line);border-radius:16px;background:color-mix(in srgb,var(--brand) 10%,var(--panel));padding:14px 12px;min-height:110px;cursor:pointer;font-family:inherit;color:inherit;
  display:grid;place-items:center;text-align:center;transition:transform .16s ease-in,background .2s;font-weight:800;line-height:1.7;font-size:1rem;overflow-wrap:anywhere}
.card2b.flipped{background:var(--panel);border-color:var(--brand)}.card2b.turning{transform:scaleX(.04)}
.card2b .front small{display:block;font-size:.75rem;color:var(--muted);margin-top:6px}.card2b .back{font-weight:700}
@media (prefers-reduced-motion:reduce){.card2b{transition:none}}
/* 🎤 chat v2: a clear box, answers wrap */
.chatbox{max-width:640px;margin:8px auto;border:1px solid var(--line);border-radius:14px;background:var(--bg);padding:8px}
.chatbox .chat{max-width:none;margin:0;max-height:260px}.msg{overflow-wrap:anywhere;line-height:1.8;max-width:88%}.msg .kw{white-space:normal}
</style>
